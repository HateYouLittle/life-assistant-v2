# Life Assistant v2 配置。复制为 .env 后修改；.env 已被 .gitignore 排除。
# npm start / npm run dev / db:backup / import:v1 都会用 Node 的
# --env-file-if-exists=.env 自动读取本文件（已存在的环境变量优先，systemd
# EnvironmentFile 不受影响）。手工执行其它命令时可 set -a; source .env; set +a。

# —— 必填 ——
# 数据目录，必须是绝对路径；所有数据（SQLite、备份）都在这里
DATA_DIR=/home/you/life-assistant-data

# —— 可选：stdio 壳 / CLI ——
# 仅 stdio 壳与 CLI 需要；纯 HTTP 直连的 daemon 不读该变量（Profile 走 X-Hermes-Profile 头）
HERMES_PROFILE=default

# —— 可选：守护进程 ——
# 默认 127.0.0.1:3080；绑定非回环地址时必须设置 WEB_API_TOKEN，否则拒绝启动
#HOST=127.0.0.1
#PORT=3080
# 保护 /api/*（Bearer 或 ?token=）与 /mcp（仅 Bearer；token 不应出现在 URL 里）
# 非回环地址下要求至少 32 字符（回环地址下短 token 只告警，方便本地零配置）
#WEB_API_TOKEN=

# —— 可选：stdio 壳访问 daemon 的 token ——
# daemon 设了 WEB_API_TOKEN 时，Hermes 注册的 stdio 壳必须带同一个 token；缺省复用 WEB_API_TOKEN
#MCP_DAEMON_TOKEN=
# stdio 壳连接的 daemon 地址（默认 http://127.0.0.1:3080）
#MCP_DAEMON_URL=http://127.0.0.1:3080

# —— 可选：QWeather（天气/空气质量/预警唯一数据源）——
# 未配置时 weather / air_quality 工具返回明确错误
# 认证：优先 JWT（Ed25519），QWEATHER_KEY 保留为回退。官方自 2027-02-01 起逐步限制
# API KEY 的每日请求数量，建议使用 JWT。
#QWEATHER_API_HOST=your-host.qweatherapi.com
#QWEATHER_KEY=your-api-key

# JWT 认证（可选，配置后优先于 QWEATHER_KEY）：
# 下面四个变量必须同时配置；只写一部分会在启动时报错，不会静默回退到 API KEY。
#QWEATHER_JWT_KEY_ID=your-credential-id
#QWEATHER_JWT_PROJECT_ID=your-project-id
#QWEATHER_JWT_DEVELOPER_ID=your-developer-id
# Ed25519 私钥（PKCS8 PEM，以 -----BEGIN PRIVATE KEY----- 开头）的绝对路径；建议权限 600
# 注意：~ 不会被展开；且启动只校验「四项是否齐全」，私钥文件本身要到首次天气请求才读取
#QWEATHER_JWT_PRIVATE_KEY_PATH=/absolute/path/to/qweather-ed25519.pem
# token 有效期（秒）：默认 43200（12 小时），上限 86400（24 小时）
#QWEATHER_JWT_TTL_SECONDS=43200

# 默认城市（Profile 未设置位置时的兜底，默认 "北京"）
#DEFAULT_CITY=北京

# —— 可选：主动推送路由密钥 ——
# 每个 Profile 的 webhook secret；URL/平台等路由结构保存在数据库 settings 中
# 单行 JSON，整段用单引号包裹（避免 source 吃掉 JSON 引号）：'{"default":"64位随机hex"}'
# 每个 secret 至少 32 字符（建议 openssl rand -hex 32，共 64 字符），过短会拒绝启动
# 生成：openssl rand -hex 32
#PROFILE_ROUTE_SECRETS_JSON='{"default":"..."}'

# —— 可选：每日简报时间（cron，Asia/Shanghai）——
#DAILY_BRIEF_CRON='0 7 * * *'

# —— 可选：气象预警主动推送（cron，Asia/Shanghai）——
# 定期为配置了推送路由的 Profile 检查生效预警，命中即推；非法 cron 会拒绝启动
#ALERT_WATCH_CRON='*/20 * * * *'
# 推送级别阈值（blue|yellow|orange|red，默认 blue=所有级别都推）；低于阈值的预警跳过
#ALERT_MIN_LEVEL=blue

# —— 可选：调休/补班提醒（cron，Asia/Shanghai）——
# 每天早上检查：今天要补班、假期临近（首日提前 N 天）、假期最后一天；非法 cron 会拒绝启动
#WORKDAY_WATCH_CRON='0 7 * * *'
# 假期首日提前提醒天数（0..30 的整数，默认 3）；决定「假期临近」提醒提前多久推送
#WORKDAY_REMIND_DAYS_BEFORE=3

# —— 可选：日志（debug|info|warn|error，默认 info）——
#LOG_LEVEL=info

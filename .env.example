# Life Assistant v2 配置。复制为 .env 后修改；.env 已被 .gitignore 排除。
# npm start / npm run dev / db:backup / db:cleanup:preview / db:restore / db:fingerprint / calendar:url / doctor / import:v1
# 都会用 Node 的 --env-file-if-exists=.env 自动读取本文件（已存在的环境变量优先，systemd
# EnvironmentFile 不受影响）。手工执行其它命令时可 set -a; source .env; set +a。

# —— 必填 ——
# 数据目录，必须是绝对路径；所有数据（SQLite、备份）都在这里
DATA_DIR=/home/you/life-assistant-data

# —— 可选：stdio 壳 / CLI ——
# 仅 stdio 壳与 CLI 需要；纯 HTTP 直连的 daemon 不读该变量（Profile 走 X-Hermes-Profile 头）
HERMES_PROFILE=default

# —— 可选：守护进程 ——
# 默认 127.0.0.1:3080；绑定非回环地址时必须设置 WEB_API_TOKEN，否则拒绝启动
# IPv6 回环可写 [::1] 或 ::1；端口一律用 PORT，别写进 HOST
#HOST=127.0.0.1
#PORT=3080
# 保护 /api/*（Bearer 或 ?token=）与 /mcp（仅 Bearer；token 不应出现在 URL 里）
# 非回环地址下要求至少 32 字符（回环地址下短 token 只告警，方便本地零配置）
#WEB_API_TOKEN=

# 强制鉴权：1/true/yes/on 时，没设置 WEB_API_TOKEN 直接拒绝启动（回环地址也强制带 token）
# 默认 0/false：只绑回环时可零配置运行；对不可信网络暴露前建议开启
#REQUIRE_AUTH=0

# 额外允许的 Host 名单（DNS rebinding / 跨站请求防护的放行名单）
# 逗号分隔；可带端口（精确匹配）也可只写主机（不限制端口），大小写不敏感
# 绑定非回环地址（如 0.0.0.0）或经反代/DNS 名访问时，必须把实际使用的 Host 写在这里，
# 否则请求会被 403（没有放行名单就无法区分用户自己的域名与攻击者解析到本机的域名）
#WEB_ALLOWED_HOSTS=example.com,192.168.1.10:3080

# —— 可选：每人一个 token（手机快捷入口 / MCP 按身份绑定）——
# JSON：{"profileId":"<token>"}；每个 token ≥32 字符，不能与 WEB_API_TOKEN 相同。
# Profile token 绑定自己的 MCP 工具、/api/quick/* 与看板 /api/*（个人视图，按身份过滤）；
# /metrics、doctor 等运维接口仍只认 WEB_API_TOKEN。
#PROFILE_TOKENS_JSON='{"default":"...","bestie":"..."}'

# —— 可选：限流（公网经 Lucky 反代后建议保留默认值）——
# 每来源 IP 每分钟请求上限（所有请求都计），默认 120；鉴权通过且带 Bearer 时再按
# token 指纹加一层（同一人可跨 IP 共用身份桶；无效/缺失凭据只计 IP 桶，轮换伪 token 不能绕过）。
# 0 表示关闭（仅本地调试）；超限返回 429 + Retry-After；/healthz、/readyz 豁免，/metrics 受限流
#RATE_LIMIT_PER_MINUTE=120
# 反代后是否采信 X-Forwarded-For（限流与日志用真实客户端 IP）。默认 0；Lucky/nginx 后面设 1
#TRUST_PROXY=0

# —— 可选：stdio 壳访问 daemon 的 token ——
# daemon 设了 WEB_API_TOKEN 时，Hermes 注册的 stdio 壳必须带同一个 token；缺省复用 WEB_API_TOKEN
#MCP_DAEMON_TOKEN=
# stdio 壳连接的 daemon 地址（默认 http://127.0.0.1:3080）
#MCP_DAEMON_URL=http://127.0.0.1:3080

# —— 可选：QWeather（天气/空气质量/预警唯一数据源）——
# 未配置时 weather / air_quality 工具返回明确错误
# 认证：优先 JWT（Ed25519），QWEATHER_KEY 保留为回退。官方自 2027-02-01 起逐步限制
# API KEY 的每日请求数量，建议使用 JWT。
#QWEATHER_API_HOST=your-host.qweatherapi.com
#QWEATHER_KEY=your-api-key

# JWT 认证（可选，配置后优先于 QWEATHER_KEY）：
# 下面四个变量必须同时配置；只写一部分会在启动时报错，不会静默回退到 API KEY。
#QWEATHER_JWT_KEY_ID=your-credential-id
#QWEATHER_JWT_PROJECT_ID=your-project-id
#QWEATHER_JWT_DEVELOPER_ID=your-developer-id
# Ed25519 私钥（PKCS8 PEM，以 -----BEGIN PRIVATE KEY----- 开头）的绝对路径；建议权限 600
# 注意：~ 不会被展开；且启动只校验「四项是否齐全」，私钥文件本身要到首次天气请求才读取
#QWEATHER_JWT_PRIVATE_KEY_PATH=/absolute/path/to/qweather-ed25519.pem
# token 有效期（秒）：默认 43200（12 小时），上限 86400（24 小时）
#QWEATHER_JWT_TTL_SECONDS=43200

# 默认城市（Profile 未设置位置时的兜底，默认 "北京"）
#DEFAULT_CITY=北京

# —— 可选：主动推送路由密钥 ——
# 每个 Profile 的 webhook secret；URL/平台等路由结构保存在数据库 settings 中
# 单行 JSON，整段用单引号包裹（避免 source 吃掉 JSON 引号）：'{"default":"64位随机hex"}'
# 每个 secret 至少 32 字符（建议 openssl rand -hex 32，共 64 字符），过短会拒绝启动
# 生成：openssl rand -hex 32
#PROFILE_ROUTE_SECRETS_JSON='{"default":"..."}'

# —— 可选：OpenClaw Gateway 推送 ——
# OpenClaw Gateway hooks token；用于 openclaw 推送通道；必须与 ~/.openclaw/openclaw.json 中的 hooks.token 一致
#OPENCLAW_HOOK_TOKEN=

# —— 可选：每日简报时间（cron，Asia/Shanghai）——
#DAILY_BRIEF_CRON='0 7 * * *'

# —— 可选：晚报时间（cron，Asia/Shanghai）——
# 晚上汇总明日日程/明早天气/逾期未完成/明日是否补班或假期；非法 cron 会拒绝启动
#EVENING_BRIEF_CRON='0 21 * * *'

# —— 可选：每日记账摘要（cron，Asia/Shanghai）——
# 汇总当天记账（笔数/合计/分类 top5）推给记账的人；逐笔回执默认不再推送（可用 notify prefs 打开）
#LEDGER_DIGEST_CRON='30 21 * * *'

# —— 可选：日志（launchd 的 stdout/stderr 重定向目录与轮转）——
# 默认 ~/Library/Logs/life-assistant；维护 job 每日 04:50 copytruncate 超过阈值的日志
#LOG_DIR='/Users/<you>/Library/Logs/life-assistant'
# 单文件超过多少 MB 才轮转（默认 20），保留份数（默认 7）
#LOG_MAX_MB=20
#LOG_KEEP=7

# —— 可选：周报（cron，Asia/Shanghai）——
# 每周日 20:00 汇总本周账单（合计/分类 top5/环比上周/预算执行）推给家庭成员
#WEEKLY_REPORT_CRON='0 20 * * 0'

# —— 可选：气象预警主动推送（cron，Asia/Shanghai）——
# 定期为所有已知 Profile 检查生效预警，命中即推；没有推送路由的 Profile 也会保留通知供 pull；非法 cron 会拒绝启动
#ALERT_WATCH_CRON='*/20 * * * *'
# 推送级别阈值（blue|yellow|orange|red，默认 blue=所有级别都推）；低于阈值的预警跳过
#ALERT_MIN_LEVEL=blue

# —— 可选：调休/补班提醒（cron，Asia/Shanghai）——
# 每天早上检查：今天要补班、假期临近（首日提前 N 天）、假期最后一天；非法 cron 会拒绝启动
#WORKDAY_WATCH_CRON='0 7 * * *'
# 假期首日提前提醒天数（0..30 的整数，默认 3）；0 表示关闭「假期临近」提醒（首日当天也不推）
#WORKDAY_REMIND_DAYS_BEFORE=3

# —— 可选：daemon 内置每日备份（cron，Asia/Shanghai）——
# daemon 每日用 VACUUM INTO 生成 $DATA_DIR/backups/life-assistant-<时间戳>.db；停机错过的
# 备份会在启动时补跑一次（24h 窗口内；长期停机仍需外部 timer）
# 生成后立即 quick_check 自校验，坏备份会被删除（不会留在 backups 里冒充可用备份）
#BACKUP_CRON='0 3 * * *'
# 保留份数（1..365 的整数，默认 14）；超出按时间戳清理最旧
#BACKUP_KEEP=14
# 恢复备份：先停 daemon，再 npm run db:restore -- --latest（或 --file <备份路径>）
# --dry-run 只校验并打印将做什么、不写盘；恢复前会把当前库留底为
# backups/life-assistant-pre-restore-<时间戳>.db，并自动删除 -wal/-shm

# —— 可选：定时任务看门狗 ——
# 单个 job 执行超时（分钟，整数，默认 15；0 或负数 = 关闭看门狗）。超时后该次 job_runs
# 记 failed（执行超时 N 分钟）、释放互斥并允许下一次触发；挂死的 handler 无法取消，
# 仍在后台跑，但不再阻塞后续触发与停机等待
#JOB_TIMEOUT_MINUTES=15

# —— 可选：日志（debug|info|warn|error，默认 info）——
#LOG_LEVEL=info
